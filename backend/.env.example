# ============================================================
# CONNECT — backend environment
# Copy to `.env` and fill in your Supabase values.
# ============================================================

# ------------------------------------------------------------
# Supabase Postgres
# ------------------------------------------------------------
# Dashboard > Project Settings > Database > Connection string.
#
# Supabase gives you TWO URLs. You need both:
#
#   DATABASE_URL  -> the shared pooler (PgBouncer, port 6543) for
#                    pooled traffic.
#   DIRECT_URL    -> the "Session pooler" (port 5432, no PgBouncer).
#                    REQUIRED for `prisma migrate`, because PgBouncer's
#                    transaction mode cannot run DDL.
#
# Prefer the "Session pooler" (not the "Transaction pooler") for DIRECT_URL
# so Prisma can also run interactive transactions.
#
# ------------------------------------------------------------
# sslmode MUST be `no-verify` — NOT `require`. This trips everyone up.
#
# Supabase's pooler presents a self-signed certificate. In
# node-postgres, `sslmode=require` does NOT relax verification: it parses
# to an empty `ssl: {}` config object, and Node's `rejectUnauthorized`
# then defaults to TRUE, so every request dies with:
#
#     Error opening a TLS connection: self-signed certificate in
#     certificate chain
#
# Only `no-verify` sets `rejectUnauthorized: false`. Your traffic is
# still TLS-encrypted; you are just not checking Supabase's cert against
# a CA bundle. Acceptable here because the hostname is pinned by
# Supabase's own DNS. If you want real verification, download Supabase's
# CA and pass it as `sslrootcert` instead.
# ------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# ------------------------------------------------------------
# Database schema
# ------------------------------------------------------------
# The app owns the dedicated Postgres schema `chat` rather than `public`,
# so this project can be shared with other applications. Nothing else
# needs configuring — the schema is created by the migration.

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Bind address. 0.0.0.0 makes the API reachable from the LAN, not just
# from this machine. Use 127.0.0.1 to keep it loopback-only.
HOST=0.0.0.0

# ------------------------------------------------------------
# Auth
# Generate each with: openssl rand -base64 48
# The two secrets MUST be different values.
# ------------------------------------------------------------
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars-long"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------
# CORS
# Comma-separated allowed origins, or * for any.
# Must match the Next.js frontend origin, scheme and port included.
#
# A `*` inside an entry is a wildcard matching any run of characters, so
# the LAN subnet keeps working when DHCP hands this machine a new address:
#
#   CORS_ORIGIN=http://localhost:3000,http://192.168.1.*:3000
#
# Each pattern is anchored, so that entry will NOT match
# `http://192.168.1.46:3000.evil.com`, a different scheme, or a different
# port — only hosts inside the subnet you named.
#
# ------------------------------------------------------------
# Behind the TLS terminator (`deploy/`), the page origin has no port:
#
#   CORS_ORIGIN=https://192.168.1.46,http://localhost:3000
#
# Caddy serves the app on 443, so requests are same-origin and CORS is not
# enforced on them. Keep the plain-HTTP entries so the terminator can be
# stopped without also having to edit this file.
# ------------------------------------------------------------
CORS_ORIGIN=https://192.168.1.46,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.*:3000
